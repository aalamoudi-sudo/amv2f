{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayadeen.local/schemas/pilot/v1/pilot-source-bundle.schema.json",
  "title": "Mayadeen Pilot Source Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sourceType", "pilotBundleId", "pilotBundleVersion",
    "eventNameAr", "eventNameEn", "eventType", "eventId", "venueId",
    "startAt", "endAt", "timeZone", "source", "sourceOwner", "preparedBy",
    "preparedAt", "approvalStatus", "approvedBy", "approvedAt",
    "securityClassification", "privacyClassification", "permittedUse",
    "retentionPolicy", "revision", "changeReason", "entities", "routes",
    "readinessRecords", "decisionRecords", "requirements", "roles",
    "authorities", "integrationProfiles", "projectionProfile",
    "physicalOutputProfile", "spatialProfile", "scenarioConfiguration",
    "captureFixtures", "evidenceRegister", "sourceRegister",
    "integrationCandidates", "entityOperationalCoverage", "enabledOperationalPackIds", "knownLimitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceType": { "enum": ["real-pilot-input", "fictional-example"] },
    "pilotBundleId": { "type": "string", "pattern": "^PILOT-BUNDLE-[A-Za-z0-9-]+$" },
    "pilotBundleVersion": { "$ref": "#/$defs/semver" },
    "eventNameAr": { "$ref": "#/$defs/nonEmptyString" },
    "eventNameEn": { "$ref": "#/$defs/nonEmptyString" },
    "eventType": { "$ref": "#/$defs/nonEmptyString" },
    "eventId": { "type": "string", "pattern": "^EVENT-[A-Za-z0-9-]+$" },
    "venueId": { "type": "string", "pattern": "^VENUE-[A-Za-z0-9-]+$" },
    "startAt": { "$ref": "#/$defs/dateTime" },
    "endAt": { "$ref": "#/$defs/dateTime" },
    "timeZone": { "$ref": "#/$defs/nonEmptyString" },
    "source": { "$ref": "#/$defs/nonEmptyString" },
    "sourceOwner": { "$ref": "#/$defs/nonEmptyString" },
    "preparedBy": { "$ref": "#/$defs/nonEmptyString" },
    "preparedAt": { "$ref": "#/$defs/dateTime" },
    "approvalStatus": { "enum": ["draft", "submitted", "under-review", "approved", "rejected", "expired"] },
    "approvedBy": { "type": ["string", "null"] },
    "approvedAt": { "type": ["string", "null"] },
    "securityClassification": { "$ref": "#/$defs/securityClassification" },
    "privacyClassification": { "enum": ["none", "internal", "personal-sensitive"] },
    "permittedUse": { "$ref": "#/$defs/nonEmptyString" },
    "retentionPolicy": { "$ref": "#/$defs/nonEmptyString" },
    "revision": { "type": "integer", "minimum": 1 },
    "changeReason": { "$ref": "#/$defs/nonEmptyString" },
    "entities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entity" } },
    "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "readinessRecords": { "type": "array", "items": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/readinessRecord" } },
    "decisionRecords": { "type": "array", "items": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/decisionRecord" } },
    "requirements": { "type": "array", "items": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/operationalRequirement" } },
    "roles": { "type": "array", "items": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/role" } },
    "authorities": { "type": "array", "items": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/authority" } },
    "integrationProfiles": { "type": "array", "items": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/integrationProfile" } },
    "projectionProfile": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/projectionProfile" },
    "physicalOutputProfile": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/physicalOutputProfile" },
    "spatialProfile": { "$ref": "#/$defs/spatialProfile" },
    "scenarioConfiguration": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/scenarioPlayerConfiguration" },
    "captureFixtures": { "type": "array", "items": { "$ref": "https://schemas.mayadeen.local/integration/v1/capture-envelope.schema.json" } },
    "evidenceRegister": { "type": "array", "items": { "$ref": "#/$defs/evidenceRegister" } },
    "sourceRegister": { "type": "array", "items": { "$ref": "#/$defs/sourceRegister" } },
    "integrationCandidates": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/integrationCandidate" } },
    "entityOperationalCoverage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entityOperationalCoverage" } },
    "enabledOperationalPackIds": { "$ref": "#/$defs/stringArray" },
    "knownLimitations": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "dateTime": { "type": "string", "minLength": 10 },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
    "securityClassification": { "enum": ["public", "internal", "restricted"] },
    "vector3": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameAr", "nameEn", "type", "parentId", "position", "rotation", "scale", "status", "readiness", "riskLevel", "capacity", "responsibleParty", "description", "metadata"],
      "properties": {
        "id": { "type": "string" },
        "nameAr": { "$ref": "#/$defs/nonEmptyString" },
        "nameEn": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["site", "zone", "hall", "gate", "route", "stage", "parking", "service", "assembly", "asset"] },
        "parentId": { "type": ["string", "null"] },
        "position": { "$ref": "#/$defs/vector3" },
        "rotation": { "$ref": "#/$defs/vector3" },
        "scale": { "$ref": "#/$defs/vector3" },
        "status": { "type": "string" },
        "readiness": { "type": "number", "minimum": 0, "maximum": 100 },
        "riskLevel": { "type": "string" },
        "capacity": { "type": "number", "minimum": 0 },
        "responsibleParty": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entityId", "nameAr", "nameEn", "type", "descriptionAr", "points", "color", "secondaryColor", "width", "defaultVisible", "relatedEntityIds", "geometrySource", "authority", "approvalStatus", "approvedBy", "approvedAt", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^ROUTE-[A-Za-z0-9-]+$" },
        "entityId": { "type": "string", "pattern": "^ROUTE-[A-Za-z0-9-]+$" },
        "nameAr": { "$ref": "#/$defs/nonEmptyString" },
        "nameEn": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["visitor", "evacuation", "service"] },
        "descriptionAr": { "$ref": "#/$defs/nonEmptyString" },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/vector3" } },
        "color": { "$ref": "#/$defs/nonEmptyString" },
        "secondaryColor": { "$ref": "#/$defs/nonEmptyString" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "defaultVisible": { "type": "boolean" },
        "relatedEntityIds": { "$ref": "#/$defs/stringArray" },
        "geometrySource": { "type": "string" },
        "authority": { "type": "string" },
        "approvalStatus": { "enum": ["draft", "submitted", "under-review", "approved", "rejected", "expired"] },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] },
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "spatialProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteBoundaryId", "localCoordinateSystem", "geographicReference", "modelReferences", "spatialMappingVersion", "projectionProfileVersion", "physicalOutputMappingVersion"],
      "properties": {
        "siteBoundaryId": { "type": "string", "pattern": "^SITE-[A-Za-z0-9-]+$" },
        "localCoordinateSystem": {
          "type": "object", "additionalProperties": false,
          "required": ["coordinateSystemId", "unit", "handedness", "upAxis", "runtimeAdapter", "origin"],
          "properties": {
            "coordinateSystemId": { "$ref": "#/$defs/nonEmptyString" },
            "unit": { "const": "meter" },
            "handedness": { "const": "right-handed" },
            "upAxis": { "const": "z-up" },
            "runtimeAdapter": { "const": "threejs-y-up-v1" },
            "origin": { "$ref": "#/$defs/vector3" }
          }
        },
        "geographicReference": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["crs", "latitude", "longitude", "elevationMeters"],
              "properties": {
                "crs": { "$ref": "#/$defs/nonEmptyString" },
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                "elevationMeters": { "type": "number" }
              }
            }
          ]
        },
        "modelReferences": { "type": "array", "items": { "$ref": "https://mayadeen.local/schemas/event-package/v1/event-package.schema.json#/$defs/modelReference" } },
        "spatialMappingVersion": { "$ref": "#/$defs/nonEmptyString" },
        "projectionProfileVersion": { "$ref": "#/$defs/nonEmptyString" },
        "physicalOutputMappingVersion": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidenceRegister": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceId", "titleAr", "evidenceType", "sourceId", "owner", "capturedAt", "status", "classification", "uri", "exampleOnly"],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^EVIDENCE-[A-Za-z0-9-]+$" },
        "titleAr": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceType": { "$ref": "#/$defs/nonEmptyString" },
        "sourceId": { "type": "string", "pattern": "^SOURCE-[A-Za-z0-9-]+$" },
        "owner": { "type": "string" },
        "capturedAt": { "$ref": "#/$defs/dateTime" },
        "status": { "enum": ["verified", "pending", "missing"] },
        "classification": { "$ref": "#/$defs/securityClassification" },
        "uri": { "type": ["string", "null"] },
        "exampleOnly": { "type": "boolean" }
      }
    },
    "sourceRegister": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "sourceNameAr", "sourceOwner", "sourceType", "authorityStatus", "updatedAt", "retentionPolicy", "classification", "exampleOnly"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^SOURCE-[A-Za-z0-9-]+$" },
        "sourceNameAr": { "$ref": "#/$defs/nonEmptyString" },
        "sourceOwner": { "type": "string" },
        "sourceType": { "enum": ["file", "manual-register", "external-system-candidate"] },
        "authorityStatus": { "enum": ["unknown", "declared", "approved"] },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "retentionPolicy": { "$ref": "#/$defs/nonEmptyString" },
        "classification": { "$ref": "#/$defs/securityClassification" },
        "exampleOnly": { "type": "boolean" }
      }
    },
    "integrationCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "path", "systemName", "owner", "direction", "method", "authenticationRequirement", "dataSupplied", "dataReceived", "stableIdMapping", "expectedFrequency", "errorBehavior", "offlineBehavior", "retryBehavior", "evidencePolicy", "securityClassification", "dataResidency", "retention", "exitExportMethod", "sandboxAvailability", "credentialAvailability", "adapterStatus", "acceptanceCriteria"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^INTEGRATION-CANDIDATE-[A-Za-z0-9-]+$" },
        "path": { "enum": ["input", "spatial", "physical"] },
        "systemName": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "type": "string" },
        "direction": { "enum": ["input", "output", "bidirectional"] },
        "method": { "enum": ["file", "api-candidate", "manual-local", "print-export"] },
        "authenticationRequirement": { "$ref": "#/$defs/nonEmptyString" },
        "dataSupplied": { "$ref": "#/$defs/stringArray" },
        "dataReceived": { "$ref": "#/$defs/stringArray" },
        "stableIdMapping": { "$ref": "#/$defs/nonEmptyString" },
        "expectedFrequency": { "$ref": "#/$defs/nonEmptyString" },
        "errorBehavior": { "$ref": "#/$defs/nonEmptyString" },
        "offlineBehavior": { "$ref": "#/$defs/nonEmptyString" },
        "retryBehavior": { "$ref": "#/$defs/nonEmptyString" },
        "evidencePolicy": { "$ref": "#/$defs/nonEmptyString" },
        "securityClassification": { "$ref": "#/$defs/securityClassification" },
        "dataResidency": { "$ref": "#/$defs/nonEmptyString" },
        "retention": { "$ref": "#/$defs/nonEmptyString" },
        "exitExportMethod": { "$ref": "#/$defs/nonEmptyString" },
        "sandboxAvailability": { "enum": ["available-local", "unavailable", "unknown"] },
        "credentialAvailability": { "enum": ["not-required", "unavailable", "unknown"] },
        "adapterStatus": { "enum": ["candidate", "reference-local", "not-executable"] },
        "acceptanceCriteria": { "$ref": "#/$defs/stringArray" }
      }
    },
    "entityOperationalCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["entityId", "readinessCoverage", "decisionCoverage", "reasonAr"],
      "properties": {
        "entityId": { "type": "string" },
        "readinessCoverage": { "enum": ["provided", "not-applicable", "unknown"] },
        "decisionCoverage": { "enum": ["provided", "not-applicable", "unknown"] },
        "reasonAr": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
