{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayadeen.local/schemas/digital-rehearsal/v1/rehearsal-projection-export.schema.json",
  "title": "Digital Rehearsal Projection Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectionVersion", "projectId", "eventId", "venueId", "planId", "runId", "eventDayId", "personaId", "personaVariantId", "momentId", "journeyStepId", "touchpointId", "selectedZoneIds", "selectedEntityIds", "selectedSiteId", "mapFocus", "sceneAssetId", "activeBranchId", "runState", "momentState", "rehearsalClock", "readinessSummary", "decisionSummary", "evidenceSummary", "narrativeState", "visualState", "cueState", "colorSemantics", "outputTimestamp", "outputTimestampClassification", "actualExecution", "mutationAllowed", "physicalStandardId", "physicalStandardVersion", "calibrationStatus", "hardwareControlAllowed", "procurementAuthorized"],
  "properties": {
    "projectionVersion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectId": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "venueId": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "runId": { "type": ["string", "null"] },
    "eventDayId": { "type": "string", "minLength": 1 },
    "personaId": { "type": "string", "minLength": 1 },
    "personaVariantId": { "type": "string", "minLength": 1 },
    "momentId": { "type": "string", "minLength": 1 },
    "journeyStepId": { "type": ["string", "null"] },
    "touchpointId": { "type": ["string", "null"] },
    "selectedZoneIds": { "type": "array", "items": { "type": "string" } },
    "selectedEntityIds": { "type": "array", "items": { "type": "string" } },
    "selectedSiteId": { "type": ["string", "null"] },
    "mapFocus": { "type": "object" },
    "sceneAssetId": { "type": ["string", "null"] },
    "activeBranchId": { "type": ["string", "null"] },
    "runState": { "enum": ["not-started", "ready", "running", "paused", "blocked", "skipped", "completed", "aborted"] },
    "momentState": { "enum": ["pending", "current", "delayed", "paused", "completed", "skipped", "blocked", "unknown"] },
    "rehearsalClock": { "type": "object" },
    "readinessSummary": { "type": "object" },
    "decisionSummary": { "type": "object" },
    "evidenceSummary": { "type": "object" },
    "narrativeState": { "type": "object" },
    "visualState": { "type": "object" },
    "cueState": { "type": "object" },
    "colorSemantics": { "const": "status-labels-primary-color-secondary" },
    "outputTimestamp": { "type": "string", "minLength": 1 },
    "outputTimestampClassification": { "enum": ["source-reported", "rehearsal-elapsed", "local-device-time-untrusted", "not-recorded"] },
    "actualExecution": { "const": false },
    "mutationAllowed": { "const": false },
    "physicalStandardId": { "const": "MEIOS-PDT-STD-001" },
    "physicalStandardVersion": { "const": "1.0.0" },
    "calibrationStatus": { "const": "not-calibrated" },
    "hardwareControlAllowed": { "const": false },
    "procurementAuthorized": { "const": false }
  }
}
