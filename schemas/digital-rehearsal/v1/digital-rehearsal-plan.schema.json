{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayadeen.local/schemas/digital-rehearsal/v1/digital-rehearsal-plan.schema.json",
  "title": "Digital Rehearsal Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "planId", "projectId", "eventId", "venueId", "experiencePackId",
    "experiencePackHash", "scenarioId", "labelAr", "labelEn", "state", "revision",
    "previousPlanHash", "planHash", "sourceReferences", "eventDays", "moments", "cues",
    "personaVariants", "executionSteps", "checkpoints", "contingencies", "supportedLenses",
    "supportedTimeModes", "createdAt", "timeTrust", "candidateOnly", "baselineMutationAllowed",
    "readinessMutationAllowed", "evidenceVerificationAllowed", "decisionApprovalAllowed", "liveExecutionAllowed"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "planId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "venueId": { "type": "string", "minLength": 1 },
    "experiencePackId": { "type": "string", "minLength": 1 },
    "experiencePackHash": { "$ref": "#/$defs/hash" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "labelAr": { "type": "string", "minLength": 1 },
    "labelEn": { "type": "string", "minLength": 1 },
    "state": { "enum": ["draft", "candidate", "frozen-for-rehearsal", "superseded", "archived"] },
    "revision": { "type": "integer", "minimum": 1 },
    "previousPlanHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "planHash": { "$ref": "#/$defs/hash" },
    "sourceReferences": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "eventDays": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "moments": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "cues": { "type": "array", "items": { "type": "object" } },
    "personaVariants": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "executionSteps": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "checkpoints": { "type": "array", "items": { "type": "object" } },
    "contingencies": { "type": "array", "items": { "type": "object" } },
    "supportedLenses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/lens" } },
    "supportedTimeModes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["manual-step", "planned-clock", "accelerated-rehearsal"] } },
    "createdAt": { "type": "string", "minLength": 1 },
    "timeTrust": { "$ref": "#/$defs/timeTrust" },
    "candidateOnly": { "const": true },
    "baselineMutationAllowed": { "const": false },
    "readinessMutationAllowed": { "const": false },
    "evidenceVerificationAllowed": { "const": false },
    "decisionApprovalAllowed": { "const": false },
    "liveExecutionAllowed": { "const": false }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timeTrust": { "enum": ["source-reported", "rehearsal-elapsed", "local-device-time-untrusted", "not-recorded"] },
    "lens": { "enum": ["visitor", "executive", "operations", "protocol", "security-safety", "content-production", "accessibility", "decision", "source-truth"] }
  }
}
