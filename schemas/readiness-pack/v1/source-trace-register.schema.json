{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayadeen.local/schemas/readiness-pack/v1/source-trace-register.schema.json",
  "title": "Readiness Source Trace Register v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "projectId",
    "eventId",
    "venueId",
    "generatedAt",
    "sourceFingerprint",
    "sourceTraceFingerprint",
    "extractionFingerprint",
    "sources",
    "sourceTraces"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "packId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "venueId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceTraceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "extractionFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "sourceRevisionId",
          "sourceRevision",
          "observedByteSize",
          "observedSha256",
          "fingerprintStatus",
          "committedBinary"
        ],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceRevisionId": { "type": "string", "minLength": 1 },
          "sourceRevision": { "type": "integer", "minimum": 1 },
          "observedByteSize": { "type": "integer", "minimum": 0 },
          "observedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "fingerprintStatus": { "enum": ["verified", "recorded-first-observation", "mismatch"] },
          "committedBinary": { "const": false }
        }
      }
    },
    "sourceTraces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "traceId",
          "sourceId",
          "sourceRevision",
          "sourceHash",
          "locatorType",
          "extractedMeaning",
          "reviewStatus"
        ],
        "properties": {
          "traceId": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceRevision": { "type": "integer", "minimum": 1 },
          "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "locatorType": { "type": "string", "minLength": 1 },
          "extractedMeaning": { "type": "string", "minLength": 1 },
          "reviewStatus": { "enum": ["founder-approved-source", "reviewed", "needs-review", "conflicted"] }
        }
      }
    }
  }
}
