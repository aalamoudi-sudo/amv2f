{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mayadeen.local/integration/v1/iot-device-registry.schema.json",
  "title": "Mayadeen Vendor-Neutral IoT Device Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deviceId", "eventRef", "venueId", "nameAr", "nameEn", "deviceClass", "lifecycleStatus", "stateContext", "sourceSystemId", "adapterId", "adapterVersion", "mappingVersion", "identityAuthority", "registeredAt", "updatedAt", "spatialBinding", "streams", "metadata"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "deviceId": { "type": "string", "minLength": 1 },
    "eventRef": { "type": ["string", "null"], "minLength": 1 },
    "venueId": { "type": "string", "minLength": 1 },
    "nameAr": { "type": "string", "minLength": 1 },
    "nameEn": { "type": "string", "minLength": 1 },
    "deviceClass": { "enum": ["counter", "occupancy-sensor", "environmental-sensor", "power-meter", "asset-health", "gateway", "generic"] },
    "lifecycleStatus": { "enum": ["simulated", "commissioning", "active", "degraded", "offline", "retired"] },
    "stateContext": { "const": "temporary-demo" },
    "sourceSystemId": { "type": "string", "minLength": 1 },
    "adapterId": { "type": "string", "minLength": 1 },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "mappingVersion": { "type": "string", "minLength": 1 },
    "identityAuthority": { "enum": ["local-simulator", "unknown"] },
    "registeredAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "spatialBinding": { "$ref": "#/$defs/spatialBinding" },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stream" }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "not": { "pattern": "([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Aa][Pp][Ii][-_]?[Kk][Ee][Yy])" }
      },
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  },
  "$defs": {
    "spatialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "entityId", "zoneId", "coordinateReference", "spatialReference", "position", "bindingStatus"],
      "properties": {
        "bindingId": { "type": "string", "minLength": 1 },
        "entityId": { "type": "string", "minLength": 1 },
        "zoneId": { "type": ["string", "null"], "minLength": 1 },
        "coordinateReference": { "enum": ["venue-local", "model-local", "geographic", "unknown"] },
        "spatialReference": { "type": ["string", "null"], "minLength": 1 },
        "position": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 }
          ]
        },
        "bindingStatus": { "enum": ["unverified", "verified"] }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streamId", "nameAr", "nameEn", "measurementType", "valueType", "unit", "minimumValue", "maximumValue", "freshnessThresholdSeconds", "enabled"],
      "properties": {
        "streamId": { "type": "string", "minLength": 1 },
        "nameAr": { "type": "string", "minLength": 1 },
        "nameEn": { "type": "string", "minLength": 1 },
        "measurementType": { "type": "string", "minLength": 1 },
        "valueType": { "enum": ["number", "string", "boolean"] },
        "unit": { "type": ["string", "null"], "minLength": 1 },
        "minimumValue": { "type": ["number", "null"] },
        "maximumValue": { "type": ["number", "null"] },
        "freshnessThresholdSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
