{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayadeen.local/schemas/experience-delivery/v1/studio-3d-delivery-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestId", "projectId", "eventId", "venueId", "sourceId", "authority", "filename", "format", "hash", "size",
    "version", "software", "softwareVersion", "renderEngine", "plugins", "destinationId", "sceneId", "dayVariant", "personaVariant",
    "cameraId", "cameraPosition", "cameraHeight", "cameraHeading", "fieldOfView", "northDirection", "units", "scale", "origin",
    "coordinateReference", "dimensions", "textureDependencies", "rightsStatus", "approvalStatus", "optimizationStatus",
    "spatialRegistrationStatus", "navmeshStatus", "collisionStatus", "projectionMappingStatus", "missingDependencies", "warnings", "sourceInventory"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "venueId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": ["string", "null"] },
    "authority": { "enum": ["unknown", "founder-supplied-working-candidate", "operational-team-supplied-working-candidate", "source-backed-working-candidate", "authority-confirmed"] },
    "filename": { "type": ["string", "null"] },
    "format": { "enum": ["glb", "gltf", "fbx", "obj", "skp", "rvt", "3dm", "c4d", "unreal-project", "unity-project", "max", "blend", "dwg", "dxf", "ifc", "usd", "usdz", "stl", "3mf", "projection-uv", "projection-mask", "calibration-reference", "video", "image-sequence", "environment-map", "jpeg-equirectangular", "tiff-equirectangular", "png-equirectangular", "webp-equirectangular", "png-flat-render", "jpeg-flat-render", "other", null] },
    "hash": { "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
    "size": { "type": ["integer", "null"], "minimum": 1 },
    "version": { "type": ["string", "null"] },
    "software": { "type": ["string", "null"] },
    "softwareVersion": { "type": ["string", "null"] },
    "renderEngine": { "type": ["string", "null"] },
    "plugins": { "$ref": "#/$defs/stringArray" },
    "destinationId": { "type": ["string", "null"] },
    "sceneId": { "type": ["string", "null"] },
    "dayVariant": { "$ref": "#/$defs/stringArray" },
    "personaVariant": { "$ref": "#/$defs/stringArray" },
    "cameraId": { "type": ["string", "null"] },
    "cameraPosition": { "anyOf": [{ "$ref": "#/$defs/vector" }, { "type": "null" }] },
    "cameraHeight": { "type": ["number", "null"] },
    "cameraHeading": { "type": ["number", "null"] },
    "fieldOfView": { "type": ["number", "null"] },
    "northDirection": { "type": ["number", "null"] },
    "units": { "enum": ["meter", "millimeter", "centimeter", "unknown", null] },
    "scale": { "type": ["number", "null"] },
    "origin": { "anyOf": [{ "$ref": "#/$defs/vector" }, { "type": "null" }] },
    "coordinateReference": { "type": ["string", "null"] },
    "dimensions": { "anyOf": [{ "$ref": "#/$defs/dimensions" }, { "type": "null" }] },
    "textureDependencies": { "$ref": "#/$defs/stringArray" },
    "rightsStatus": { "enum": ["unknown", "review-required", "internal-preview-only", "client-review-approved", "blocked"] },
    "approvalStatus": { "enum": ["unknown", "candidate", "reviewed", "approved-for-candidate-binding", "rejected"] },
    "optimizationStatus": { "enum": ["unknown", "required", "in-progress", "review-ready", "optimized"] },
    "spatialRegistrationStatus": { "enum": ["unknown", "required", "candidate", "registered"] },
    "navmeshStatus": { "enum": ["unknown", "not-provided", "candidate", "validated"] },
    "collisionStatus": { "enum": ["unknown", "not-provided", "candidate", "validated"] },
    "projectionMappingStatus": { "enum": ["unknown", "not-provided", "candidate", "registered"] },
    "missingDependencies": { "$ref": "#/$defs/stringArray" },
    "warnings": { "$ref": "#/$defs/stringArray" },
    "sourceInventory": { "anyOf": [{ "$ref": "#/$defs/sourceInventory" }, { "type": "null" }] }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRecordId", "localOpaqueSourceId", "originalFilename", "safeDisplayFilename", "sourceType", "mimeType",
        "byteSize", "sha256", "fingerprintState", "sourceOwner", "suppliedBy", "suppliedAt", "revision",
        "claimedApprovalStatus", "verifiedAuthorityStatus", "confidentialityClassification", "retentionClassification",
        "relevantDayIds", "relevantPersonaIds", "relevantDestinationIds", "relevantWorkstreamIds", "extractionStatus",
        "conflictStatus", "acceptanceStatus", "modifiedAtReported", "pathDisclosure"
      ],
      "properties": {
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "localOpaqueSourceId": { "type": "string", "minLength": 1 },
        "originalFilename": { "type": "string", "minLength": 1 },
        "safeDisplayFilename": { "type": "string", "minLength": 1 },
        "sourceType": { "enum": ["pdf", "xlsx", "csv", "docx", "pptx", "json", "zip", "studio-asset", "unknown"] },
        "mimeType": { "type": ["string", "null"] },
        "byteSize": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fingerprintState": { "enum": ["verified", "changed-after-fingerprint", "not-verified"] },
        "sourceOwner": { "type": ["string", "null"] },
        "suppliedBy": { "type": ["string", "null"] },
        "suppliedAt": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] },
        "claimedApprovalStatus": { "type": ["string", "null"] },
        "verifiedAuthorityStatus": { "enum": ["unknown", "founder-supplied-working-candidate", "operational-team-supplied-working-candidate", "source-backed-working-candidate", "authority-confirmed"] },
        "confidentialityClassification": { "enum": ["public", "internal", "confidential", "restricted", "unknown"] },
        "retentionClassification": { "enum": ["review-session", "project-record-candidate", "quarantine", "unknown"] },
        "relevantDayIds": { "$ref": "#/$defs/stringArray" },
        "relevantPersonaIds": { "$ref": "#/$defs/stringArray" },
        "relevantDestinationIds": { "$ref": "#/$defs/stringArray" },
        "relevantWorkstreamIds": { "$ref": "#/$defs/stringArray" },
        "extractionStatus": { "enum": ["not-started", "inventory-only", "metadata-extracted", "structured-preview-ready", "blocked"] },
        "conflictStatus": { "enum": ["none", "duplicate", "conflicting-content", "unresolved"] },
        "acceptanceStatus": { "enum": ["missing", "discovered", "inventory-created", "invalid", "incomplete", "quarantined", "duplicate", "conflict", "structurally-valid", "awaiting-authority", "awaiting-founder-review", "accepted-as-candidate", "optimization-required", "ready-for-binding", "bound", "rejected", "rolled-back"] },
        "modifiedAtReported": { "type": ["string", "null"] },
        "pathDisclosure": { "const": "redacted" }
      }
    }
  }
}
