{
  "name": "mayadeen-event-intelligence-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arabic-first operational 3D event intelligence platform foundation.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:gateway": "tsx server/gateway/index.ts",
    "dev:app": "vite --host 127.0.0.1",
    "dev:stack": "sh -c 'pnpm dev:gateway & gateway_pid=$!; pnpm dev:app & app_pid=$!; trap \"kill $gateway_pid $app_pid\" INT TERM EXIT; wait $gateway_pid $app_pid'",
    "build": "tsc -b && vite build",
    "build:kaga": "VITE_KAGA_EXECUTIVE=true tsc -b && VITE_KAGA_EXECUTIVE=true vite build",
    "build:kaga:v2": "VITE_KAGA_EXECUTIVE=true VITE_KAGA_V2=true tsc -b && VITE_KAGA_EXECUTIVE=true VITE_KAGA_V2=true vite build",
    "build:kaga:production": "VITE_KAGA_EXECUTIVE=true VITE_KAGA_V2=true VITE_KAGA_FINAL=true tsc -b && VITE_KAGA_EXECUTIVE=true VITE_KAGA_V2=true VITE_KAGA_FINAL=true vite build",
    "build:kaga:absolute-final": "VITE_KAGA_EXECUTIVE=true VITE_KAGA_V2=true VITE_KAGA_FINAL=true VITE_KAGA_ABSOLUTE_FINAL=true tsc -b && VITE_KAGA_EXECUTIVE=true VITE_KAGA_V2=true VITE_KAGA_FINAL=true VITE_KAGA_ABSOLUTE_FINAL=true vite build",
    "verify:kaga:client-runtime": "tsx scripts/kaga-final/verify-client-runtime.ts",
    "verify:kaga:absolute-final-runtime": "KAGA_RUNTIME_DIST=dist-kaga-absolute-final tsx scripts/kaga-final/verify-client-runtime.ts",
    "preview": "vite preview --host 127.0.0.1",
    "preview:kaga": "VITE_KAGA_EXECUTIVE=true vite preview --host 127.0.0.1 --port 4174",
    "preview:kaga:v2": "VITE_KAGA_EXECUTIVE=true VITE_KAGA_V2=true vite preview --host 127.0.0.1 --port 4175",
    "preview:kaga:production": "vite preview --host 127.0.0.1 --port 4176 --outDir dist-kaga-final",
    "preview:kaga:absolute-final": "vite preview --host 127.0.0.1 --port 4177 --outDir dist-kaga-absolute-final",
    "review:platform": "node scripts/review-platform.mjs",
    "review:stage3e4a": "tsx scripts/package-stage3e4a-review.ts",
    "review:stage3e4b": "tsx scripts/package-stage3e4b-review.ts",
    "package:stage3e4c": "tsx scripts/package-stage3e4c-review.ts",
    "review:stage3e4c": "node scripts/review-stage3e4c.mjs",
    "package:stage3g0": "tsx scripts/package-stage3g0-review.ts",
