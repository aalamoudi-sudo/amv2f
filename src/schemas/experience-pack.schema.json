{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayadeen.local/schemas/experience-pack-v1.json",
  "title": "Mayadeen ExperiencePack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "projectId",
    "eventId",
    "venueId",
    "organizationId",
    "labelAr",
    "labelEn",
    "eventType",
    "packageStatus",
    "sourceClassification",
    "frozen",
    "activated",
    "baseline",
    "operationalApproval",
    "revision",
    "contentHash",
    "sourceIds",
    "sourceTraces",
    "scenarios",
    "eventDays",
    "siteCandidates",
    "personas",
    "operationalLenses",
    "journeys",
    "journeySteps",
    "touchpoints",
    "experienceAreas",
    "spatialRelations",
    "programMoments",
    "contentCues",
    "sceneAssets",
    "dailyLearningDrafts",
    "defaultSelection",
    "limitationsAr"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packId": { "$ref": "#/$defs/id" },
    "packVersion": { "$ref": "#/$defs/text" },
    "projectId": { "$ref": "#/$defs/id" },
    "eventId": { "$ref": "#/$defs/id" },
    "venueId": { "$ref": "#/$defs/id" },
    "organizationId": { "$ref": "#/$defs/id" },
    "labelAr": { "$ref": "#/$defs/text" },
    "labelEn": { "$ref": "#/$defs/text" },
    "eventType": { "$ref": "#/$defs/text" },
    "packageStatus": { "enum": ["candidate", "fictional-test-reference"] },
    "sourceClassification": { "enum": ["source-backed-candidate", "fictional-test-reference"] },
    "frozen": { "const": false },
    "activated": { "const": false },
    "baseline": { "const": false },
    "operationalApproval": { "const": "none" },
    "revision": { "type": "integer", "minimum": 1 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIds": { "$ref": "#/$defs/idArray" },
    "sourceTraces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceTrace" } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
    "eventDays": { "type": "array", "items": { "$ref": "#/$defs/eventDay" } },
    "siteCandidates": { "type": "array", "items": { "$ref": "#/$defs/siteCandidate" } },
    "personas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/persona" } },
    "operationalLenses": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/lens" } },
    "journeys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/journey" } },
    "journeySteps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/journeyStep" } },
    "touchpoints": { "$ref": "#/$defs/objectArray" },
    "experienceAreas": { "$ref": "#/$defs/objectArray" },
    "spatialRelations": { "$ref": "#/$defs/objectArray" },
    "programMoments": { "$ref": "#/$defs/objectArray" },
    "contentCues": { "$ref": "#/$defs/objectArray" },
    "sceneAssets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sceneAsset" } },
    "dailyLearningDrafts": { "$ref": "#/$defs/objectArray" },
    "defaultSelection": { "$ref": "#/$defs/defaultSelection" },
    "limitationsAr": { "$ref": "#/$defs/textArray" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "idArray": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "textArray": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "objectArray": { "type": "array", "items": { "type": "object" } },
    "attendance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "qualifier", "classification"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0 },
        "qualifier": { "enum": ["exact", "more-than", "unknown"] },
        "classification": { "const": "source-declared-not-capacity" }
      }
    },
    "sourceTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "sourceId", "sourceHash", "sourcePage", "extractionMethod", "extractedBy", "extractedAtStatus", "authority", "confidence", "interpretationStatus", "founderConfirmationStatus", "sanitizedMeaningAr"],
      "properties": {
        "traceId": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourcePage": { "type": "integer", "minimum": 1 },
        "extractionMethod": { "const": "human-reviewed-source-extraction" },
        "extractedBy": { "const": "local-human-review-process" },
        "extractedAtStatus": { "enum": ["local-process-time-untrusted", "not-recorded"] },
        "authority": { "enum": ["founder-provided-candidate-program-and-design-reference", "fictional-test-reference"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "interpretationStatus": { "enum": ["directly-source-backed", "interpreted-candidate", "founder-directed", "missing", "conflicting"] },
        "founderConfirmationStatus": { "enum": ["founder-working-candidate", "founder-directed", "not-confirmed", "not-applicable"] },
        "sanitizedMeaningAr": { "$ref": "#/$defs/text" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "scenarioType", "labelAr", "labelEn", "durationDays", "durationPattern", "sourceDeclaredAttendance", "intendedEffectAr", "status", "eventDayIds", "sourceTraceIds"],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/id" },
        "scenarioType": { "$ref": "#/$defs/text" },
        "labelAr": { "$ref": "#/$defs/text" },
        "labelEn": { "$ref": "#/$defs/text" },
        "durationDays": { "type": "integer", "minimum": 1 },
        "durationPattern": { "enum": ["consecutive", "within-month"] },
        "sourceDeclaredAttendance": { "$ref": "#/$defs/attendance" },
        "intendedEffectAr": { "$ref": "#/$defs/text" },
        "status": { "enum": ["founder-working-candidate", "source-candidate", "fictional-test-reference"] },
        "eventDayIds": { "$ref": "#/$defs/idArray" },
        "sourceTraceIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "eventDay": {
      "type": "object",
      "required": ["eventDayId", "scenarioId", "date", "labelAr", "order", "primaryPersonaId", "personaIds", "sourceDeclaredAttendance", "siteCandidateIds", "programMomentIds", "journeyIds", "contentCueIds", "operationalGateIds", "sourceTraceIds", "operationalJourneyStatus", "visitorJourneyStatus", "spatialRouteRequired", "sharedVisitorTransitionRequired", "contextRelationship", "status"],
      "properties": {
        "eventDayId": { "$ref": "#/$defs/id" },
        "scenarioId": { "$ref": "#/$defs/id" },
        "date": { "type": "string", "format": "date" },
        "labelAr": { "$ref": "#/$defs/text" },
        "order": { "type": "integer", "minimum": 1 },
        "primaryPersonaId": { "$ref": "#/$defs/id" },
        "personaIds": { "$ref": "#/$defs/idArray" },
        "sourceDeclaredAttendance": { "$ref": "#/$defs/attendance" },
        "siteCandidateIds": { "$ref": "#/$defs/idArray" },
        "programMomentIds": { "$ref": "#/$defs/idArray" },
        "journeyIds": { "$ref": "#/$defs/idArray" },
        "contentCueIds": { "$ref": "#/$defs/idArray" },
        "operationalGateIds": { "$ref": "#/$defs/idArray" },
        "sourceTraceIds": { "$ref": "#/$defs/idArray" },
        "operationalJourneyStatus": { "enum": ["candidate", "not-applicable"] },
        "visitorJourneyStatus": { "enum": ["candidate", "not-applicable"] },
        "spatialRouteRequired": { "type": "boolean" },
        "sharedVisitorTransitionRequired": { "type": "boolean" },
        "contextRelationship": { "enum": ["single-event-context", "separate-ceremony-activation-contexts-no-shared-transition"] },
        "status": { "enum": ["working-candidate", "fictional-test-reference"] }
      }
    },
    "siteCandidate": {
      "type": "object",
      "required": ["siteCandidateId", "labelAr", "labelEn", "existingVenueId", "status", "engineeringStatus", "approvalStatus", "sourceTraceIds"],
      "properties": {
        "siteCandidateId": { "$ref": "#/$defs/id" },
        "labelAr": { "$ref": "#/$defs/text" },
        "labelEn": { "$ref": "#/$defs/text" },
        "existingVenueId": { "type": ["string", "null"] },
        "status": { "const": "candidate" },
        "engineeringStatus": { "const": "unverified" },
        "approvalStatus": { "const": "not-approved" },
        "sourceTraceIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "persona": {
      "type": "object",
      "required": ["personaId", "labelAr", "labelEn", "personaType", "descriptionAr", "status", "sourceTraceIds"],
      "properties": {
        "personaId": { "$ref": "#/$defs/id" },
        "labelAr": { "$ref": "#/$defs/text" },
        "labelEn": { "$ref": "#/$defs/text" },
        "personaType": { "$ref": "#/$defs/text" },
        "descriptionAr": { "$ref": "#/$defs/text" },
        "status": { "enum": ["source-backed-candidate", "interpreted-candidate", "fictional-test-reference"] },
        "sourceTraceIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "lens": {
      "type": "object",
      "required": ["lensId", "labelAr", "labelEn", "descriptionAr", "visibleProjectionKinds"],
      "properties": {
        "lensId": { "enum": ["experience", "executive", "operations", "protocol", "security", "accessibility", "content-and-show", "readiness-and-decisions", "source-truth"] },
        "labelAr": { "$ref": "#/$defs/text" },
        "labelEn": { "$ref": "#/$defs/text" },
        "descriptionAr": { "$ref": "#/$defs/text" },
        "visibleProjectionKinds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "journey": {
      "type": "object",
      "required": ["journeyId", "scenarioId", "eventDayId", "personaId", "labelAr", "labelEn", "journeyStepIds", "sequenceType", "visitorJourneyStatus", "spatialRouteRequired", "sharedVisitorTransitionRequired", "status", "physicalRouteId", "routeAuthority", "sourceTraceIds"],
      "properties": {
        "journeyId": { "$ref": "#/$defs/id" },
        "scenarioId": { "$ref": "#/$defs/id" },
        "eventDayId": { "$ref": "#/$defs/id" },
        "personaId": { "$ref": "#/$defs/id" },
        "labelAr": { "$ref": "#/$defs/text" },
        "labelEn": { "$ref": "#/$defs/text" },
        "journeyStepIds": { "$ref": "#/$defs/idArray" },
        "sequenceType": { "enum": ["visitor-journey", "ceremonial-content-sequence"] },
        "visitorJourneyStatus": { "enum": ["candidate", "not-applicable"] },
        "spatialRouteRequired": { "type": "boolean" },
        "sharedVisitorTransitionRequired": { "type": "boolean" },
        "status": { "enum": ["candidate", "fictional-test-reference"] },
        "physicalRouteId": { "type": "null" },
        "routeAuthority": { "const": "none" },
        "sourceTraceIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "journeyStep": {
      "type": "object",
      "required": ["journeyStepId", "eventDayId", "touchpointId", "labelAr", "labelEn", "order", "relatedZoneIds", "relatedEntityIds", "relatedDecisionIds", "relatedRequirementIds", "relatedEvidenceIds", "experienceAreaCandidateIds", "sceneAssetIds", "contentCueIds", "experienceIntent", "spatialStatus", "truthClass", "sourceTraceIds"],
      "properties": {
        "journeyStepId": { "$ref": "#/$defs/id" },
        "eventDayId": { "$ref": "#/$defs/id" },
        "touchpointId": { "$ref": "#/$defs/id" },
        "labelAr": { "$ref": "#/$defs/text" },
        "labelEn": { "$ref": "#/$defs/text" },
        "order": { "type": "integer", "minimum": 1 },
        "relatedZoneIds": { "$ref": "#/$defs/idArray" },
        "relatedEntityIds": { "$ref": "#/$defs/idArray" },
        "relatedDecisionIds": { "$ref": "#/$defs/idArray" },
        "relatedRequirementIds": { "$ref": "#/$defs/idArray" },
        "relatedEvidenceIds": { "$ref": "#/$defs/idArray" },
        "experienceAreaCandidateIds": { "$ref": "#/$defs/idArray" },
        "sceneAssetIds": { "$ref": "#/$defs/idArray" },
        "contentCueIds": { "$ref": "#/$defs/idArray" },
        "experienceIntent": { "type": "object" },
        "spatialStatus": { "enum": ["candidate-anchor", "semantic-only", "unresolved-no-anchor"] },
        "truthClass": { "$ref": "#/$defs/truthClass" },
        "sourceTraceIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "sceneAsset": {
      "type": "object",
      "required": ["assetId", "projectId", "eventId", "venueId", "scenarioIds", "eventDayIds", "personaIds", "journeyStepIds", "relatedZoneIds", "relatedEntityIds", "medium", "unavailableMedium", "sourceId", "sourceHash", "sourceRevision", "sourcePage", "sourceAuthority", "truthClass", "approvalStatus", "rightsStatus", "capturedAt", "generatedAt", "dimensions", "sizeBytes", "orientation", "pose", "units", "cubemapFaces", "hotspots", "fallbackAssetId", "localPreviewUri", "revision", "notes"],
      "properties": {
        "assetId": { "$ref": "#/$defs/id" },
        "projectId": { "$ref": "#/$defs/id" },
        "eventId": { "$ref": "#/$defs/id" },
        "venueId": { "$ref": "#/$defs/id" },
        "scenarioIds": { "$ref": "#/$defs/idArray" },
        "eventDayIds": { "$ref": "#/$defs/idArray" },
        "personaIds": { "$ref": "#/$defs/idArray" },
        "journeyStepIds": { "$ref": "#/$defs/idArray" },
        "relatedZoneIds": { "$ref": "#/$defs/idArray" },
        "relatedEntityIds": { "$ref": "#/$defs/idArray" },
        "medium": { "enum": ["illustrated-map", "render-reference", "panorama-equirectangular", "panorama-cubemap", "gltf-model", "glb-model", "video", "image", "missing-source"] },
        "unavailableMedium": { "type": ["string", "null"], "enum": ["illustrated-map", "render-reference", "panorama-equirectangular", "panorama-cubemap", "gltf-model", "glb-model", "video", "image", null] },
        "sourceId": { "type": ["string", "null"] },
        "sourceHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "sourceRevision": { "type": ["string", "null"] },
        "sourcePage": { "type": ["integer", "null"], "minimum": 1 },
        "sourceAuthority": { "$ref": "#/$defs/text" },
        "truthClass": { "$ref": "#/$defs/truthClass" },
        "approvalStatus": { "enum": ["candidate", "approved", "missing", "unknown"] },
        "rightsStatus": { "enum": ["review-only", "approved", "missing", "unknown"] },
        "capturedAt": { "type": ["string", "null"] },
        "generatedAt": { "type": ["string", "null"] },
        "dimensions": { "type": ["object", "null"] },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "orientation": { "type": ["object", "null"] },
        "pose": { "type": ["object", "null"] },
        "units": { "type": ["object", "null"] },
        "cubemapFaces": { "type": ["array", "null"] },
        "hotspots": { "type": "array" },
        "fallbackAssetId": { "type": ["string", "null"] },
        "localPreviewUri": { "type": ["string", "null"] },
        "revision": { "type": "object" },
        "notes": { "$ref": "#/$defs/textArray" }
      }
    },
    "truthClass": { "enum": ["illustrative-only", "source-backed-candidate", "design-candidate", "design-approved", "field-reported", "field-verified", "actual-verified", "live-reported", "live-verified"] },
    "defaultSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "eventDayId", "personaId", "journeyId", "journeyStepId", "lens", "mapMode", "viewMode"],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/id" },
        "eventDayId": { "$ref": "#/$defs/id" },
        "personaId": { "$ref": "#/$defs/id" },
        "journeyId": { "$ref": "#/$defs/id" },
        "journeyStepId": { "$ref": "#/$defs/id" },
        "lens": { "enum": ["experience", "executive", "operations", "protocol", "security", "accessibility", "content-and-show", "readiness-and-decisions", "source-truth"] },
        "mapMode": { "enum": ["story", "operational", "illustrated", "web3d", "panorama"] },
        "viewMode": { "enum": ["split", "map-focus", "scene-focus", "presentation", "internal"] }
      }
    }
  }
}
